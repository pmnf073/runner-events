# Database
DATABASE_URL="postgresql://user:password@localhost:5432/runnerevents?schema=public"

# Signs the login tokens (JWT). Required in production; generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Frontend origin (OAuth redirects; CORS in production)
FRONTEND_URL="http://localhost:5173"

# Optional: email via Resend (password recovery, reminders, announcements).
# Without both, emails are only logged.
RESEND_API_KEY=""
EMAIL_FROM=""

# Club details shown in emails and PDF receipts
CLUB_NAME="Alverca Urban Runners"
CLUB_NIF=""
CLUB_ADDRESS=""

# Optional: TeamUp ICS feed imported every hour
TEAMUP_ICS_FEED=""

# Google OAuth (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Facebook OAuth (get from https://developers.facebook.com)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:3001/auth/facebook/callback"

# Admin created by `npm run db:seed` (also the login used by the seed_remote scripts)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
