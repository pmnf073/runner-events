# ============================================
# PRODUCTION ENV - RunnerEvents Backend
# ============================================
# Copy this to .env and fill in your values

# Database (Neon / Supabase / any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/runner_events?sslmode=require"

# JWT Secret (gera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="replace-with-random-secret"

# Frontend URL (Vercel deployment)
FRONTEND_URL="https://runner-events.vercel.app"
FRONTEND_URLS="https://runner-events.vercel.app,https://alvercaurbanrunners.pt,https://www.alvercaurbanrunners.pt"

# Backend port (Render default)
PORT=3001

# NODE_ENV
NODE_ENV="production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://runner-events-api.onrender.com/auth/google/callback"

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="https://runner-events-api.onrender.com/auth/facebook/callback"
